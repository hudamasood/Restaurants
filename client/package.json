{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:seo && tsc -b && vite build && npm run build:prerender",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:api": "node --experimental-strip-types scripts/dev-api.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs && npx esbuild scripts/seed-menu.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=node_modules/.seed/seed-menu.mjs && node node_modules/.seed/seed-menu.mjs",
    "build:seo": "node scripts/build-seo.mjs && node scripts/build-og.mjs",
    "build:prerender": "node scripts/build-prerender.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.102.2",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.10",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "web-vitals": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
