# Postgres connection string (Neon).
# Copy to .env and fill in. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# Ordering is built but dark at launch.
VITE_FEATURE_ORDERING=false

# Transactional email (Resend). Without a key, confirmation emails are
# skipped and the API reports emailed:false — bookings still succeed.
RESEND_API_KEY=
EMAIL_FROM="Marrow & Hearth <reservations@yourdomain.com>"
EMAIL_REPLY_TO="reservations@yourdomain.com"

# Where contact-form enquiries are delivered. Falls back to EMAIL_REPLY_TO.
ENQUIRY_INBOX=

# Signs admin session tokens. At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Object storage for uploaded images. S3-compatible; Cloudflare R2 is the
# cheaper fit here since images are served on every page and R2 has no egress
# fee. Without these, uploads are refused with a clear message.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN domain in front of the bucket. Defaults to endpoint/bucket.
S3_PUBLIC_BASE=

# Where Core Web Vitals are POSTed. Unset means log in dev, no-op in prod.
VITE_VITALS_ENDPOINT=
